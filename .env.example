TMDB_READ_TOKEN=your_tmdb_read_access_token

# Public API URL only; never put a credential in a VITE_ variable.
# VITE_API_BASE_URL=https://your-api.example/api/tmdb
# FRONTEND_ORIGIN=https://svici042.github.io

# Required for npm start; use a certificate valid for your hostname.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Only set when a trusted proxy overwrites X-Real-IP and the app port is private.
# TRUSTED_PROXY_IPS=127.0.0.1
